<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <IsPackable>false</IsPackable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Octelys.MediatorPlugin.Tests</RootNamespace>
        <AssemblyName>Octelys.MediatorPlugin.Tests</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.ReSharper.SDK.Tests" Version="$(SdkVersion)" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="test/**/*" />
        <None Include="test/**/*" />
        <None Remove="Packages\**" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MediatorPlugin\MediatorPlugin.csproj" />
    </ItemGroup>
</Project>
